# Ключи — никогда в git
.env
*.pem
*.key
*service-account*.json
*credentials*.json

# Разовое: своя папка на задачу, итоги остаются в ней же.
# Git следит за системой (скиллы, скрипты, правила), а не за результатами работы.
tasks/

# Данные на вход
temp/

# Итоги регулярных задач — на диске, но не в истории
outputs/

# Мусор рантайма
__pycache__/
*.py[cod]
*.new
.DS_Store
Thumbs.db
